# Axone Cosmos SDK LCD / REST endpoint.
AXONE_REST_URL=https://example.invalid

# Minimum active delegation required to qualify, expressed in uaxone.
AXONE_MIN_STAKE_UAXONE=1000000

# Cosmos pagination page size.
AXONE_STAKING_PAGE_LIMIT=100

# Telegram Bot API token.
# Keep the real token only in your local .env file.
TELEGRAM_BOT_TOKEN=
