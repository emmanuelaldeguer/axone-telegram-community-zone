+#[cfg(test)]
+mod author_index_tests {
+    use super::*;
+    use cosmwasm_std::testing::MockStorage;
+
+    fn add(storage: &mut MockStorage, who: &str, verdict: &str) -> DecisionRecord {
+        record_decision(
+            storage,
+            Decision::new(
+                &ConstitutionStatus::new(0, [0; 32]),
+                "case".into(),
+                verdict.into(),
+                None,
+                Addr::unchecked(who),
+                1,
+                1,
+            ),
+        )
+        .unwrap()
+    }
+
+    #[test]
+    fn full_records_and_exclusive_pagination() {
+        let mut s = MockStorage::new();
+        AUTHOR_INDEX_VERSION.save(&mut s, &1).unwrap();
+        let a = Addr::unchecked("alice");
+        add(&mut s, "alice", "allowed");
+        add(&mut s, "bob", "other");
+        let denied = add(&mut s, "alice", "denied");
+        add(&mut s, "alice", "revoked");
+        let (page, next) = load_decisions_by_author(&s, &a, None, Some(2), true).unwrap();
+        assert_eq!(
+            page.iter().map(DecisionRecord::id).collect::<Vec<_>>(),
+            vec![4, 3]
+        );
+        assert_eq!(page[1], denied);
+        assert_eq!(next, Some(3));
+        let (page, next) = load_decisions_by_author(&s, &a, next, Some(2), true).unwrap();
+        assert_eq!(page[0].id(), 1);
+        assert_eq!(next, None);
+        let (page, next) = load_decisions_by_author(&s, &a, Some(1), Some(1), false).unwrap();
+        assert_eq!(page[0].id(), 3);
+        assert_eq!(next, Some(3));
+        assert!(load_decisions_by_author(&s, &a, None, Some(0), true).is_err());
+    }
+
+    #[test]
+    fn legacy_writes_do_not_claim_completeness() {
+        let mut s = MockStorage::new();
+        add(&mut s, "alice", "new");
+        let a = Addr::unchecked("alice");
+        assert!(load_decisions_by_author(&s, &a, None, None, true).is_err());
+        AUTHOR_INDEX_VERSION.save(&mut s, &2).unwrap();
+        assert!(load_decisions_by_author(&s, &a, None, None, true).is_err());
+    }
+
+    #[test]
+    fn broken_reference_is_an_error() {
+        let mut s = MockStorage::new();
+        AUTHOR_INDEX_VERSION.save(&mut s, &1).unwrap();
+        let a = Addr::unchecked("alice");
+        add(&mut s, "bob", "other");
+        DECISIONS_BY_AUTHOR.save(&mut s, (&a, 1), &()).unwrap();
+        assert!(load_decisions_by_author(&s, &a, None, None, true).is_err());
+        DECISIONS_BY_AUTHOR.remove(&mut s, (&a, 1));
+        DECISIONS_BY_AUTHOR.save(&mut s, (&a, 99), &()).unwrap();
+        assert!(load_decisions_by_author(&s, &a, None, None, true).is_err());
+    }
+}
