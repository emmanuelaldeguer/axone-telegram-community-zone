+pub fn load_decisions_by_author(
+    storage: &dyn Storage,
+    author: &Addr,
+    start_after: Option<u64>,
+    limit: Option<u32>,
+    descending: bool,
+) -> Result<(Vec<DecisionRecord>, Option<u64>), AxoneGovError> {
+    if AUTHOR_INDEX_VERSION.may_load(storage)? != Some(1) {
+        return Err(
+            StdError::generic_err("author index unavailable: complete migration required").into(),
+        );
+    }
+    let limit = limit
+        .unwrap_or(DEFAULT_DECISIONS_LIMIT)
+        .min(MAX_DECISIONS_LIMIT) as usize;
+    if limit == 0 {
+        return Err(StdError::generic_err("author index limit must be positive").into());
+    }
+    let cursor = start_after.map(Bound::exclusive);
+    let (min, max, order) = if descending {
+        (None, cursor, Order::Descending)
+    } else {
+        (cursor, None, Order::Ascending)
+    };
+    let ids = DECISIONS_BY_AUTHOR
+        .prefix(author)
+        .keys(storage, min, max, order)
+        .take(limit + 1)
+        .collect::<Result<Vec<_>, _>>()?;
+    let next = if ids.len() > limit {
+        ids.get(limit - 1).copied()
+    } else {
+        None
+    };
+    let records = ids
+        .into_iter()
+        .take(limit)
+        .map(|id| {
+            let record = DECISIONS.load(storage, id)?;
+            if record.author != *author {
+                return Err(StdError::generic_err("author index record mismatch").into());
+            }
+            Ok(record)
+        })
+        .collect::<Result<Vec<_>, AxoneGovError>>()?;
+    Ok((records, next))
+}
