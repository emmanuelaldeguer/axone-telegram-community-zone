{
  "name": "axone-telegram-community-zone",
  "version": "0.1.0",
  "private": true,
  "description": "Experimental Axone-governed Telegram community zone prototype",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
"scripts": {
  "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
  "build": "npm run clean && tsc -p tsconfig.json",
  "test": "node --test dist/test/*.test.js",
  "test:prolog": "cd tools/prolog-smoke && go test -v",
  "ci": "npm run build && npm test && npm run test:prolog",
  "stake": "npm run build --silent && node --env-file=.env dist/src/cli.js",
  "telegram:once": "npm run build --silent && node --env-file=.env dist/src/telegram/once.js"
},

  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
}
